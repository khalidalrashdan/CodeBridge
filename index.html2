<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CodeBridge</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Press+Start+2P&family=JetBrains+Mono&display=swap" rel="stylesheet">
<style>
:root{--bg:#10121c;--panel:#191c2b;--line:#2f3558;--ink:#eef0f8;--mute:#9aa1c0;--gold:#ffd23f;--mint:#4de0b4;--red:#ff6b81;--blue:#6c8cff;--btn-ink:#1a1400}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Cairo,system-ui,sans-serif;line-height:1.6}
h1,h2,h3{margin:0 0 .5rem}
.px{font-family:"Press Start 2P",Cairo,monospace;line-height:1.5}
nav{display:flex;align-items:center;gap:1rem;padding:.9rem 1.5rem;border-bottom:3px solid var(--line);flex-wrap:wrap}
nav .logo{font-size:.9rem;color:var(--gold);margin-inline-end:auto;cursor:pointer}
nav a,nav button.link{color:var(--ink);background:none;border:0;font:inherit;cursor:pointer;padding:.25rem .5rem}
nav a:hover,nav button.link:hover{color:var(--gold)}
main{max-width:1000px;margin:0 auto;padding:1.5rem}
.card{background:var(--panel);border:3px solid var(--line);box-shadow:5px 5px 0 #000;padding:1.25rem;border-radius:6px}
.grid{display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}
button.btn{background:var(--gold);color:var(--btn-ink);border:3px solid #000;box-shadow:3px 3px 0 #000;padding:.6rem 1.1rem;font:700 1rem Cairo,sans-serif;cursor:pointer;border-radius:4px}
button.btn:active{transform:translate(3px,3px);box-shadow:none}
button.btn.alt{background:var(--panel);color:var(--ink);border-color:var(--line)}
button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid var(--mint);outline-offset:2px}
input,select,textarea{width:100%;background:#0a0b12;color:var(--ink);border:2px solid var(--line);border-radius:4px;padding:.65rem;font:inherit;margin:.25rem 0 .9rem}
textarea{font-family:"JetBrains Mono",monospace;min-height:170px;direction:ltr;text-align:left;resize:vertical}
label{color:var(--mute);font-size:.9rem}
pre{background:#0a0b12;border:2px solid var(--line);border-radius:4px;padding:1rem;overflow-x:auto;direction:ltr;text-align:left;font-family:"JetBrains Mono",monospace;color:var(--mint)}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1rem}
.stat b{display:block;font-family:"Press Start 2P",monospace;font-size:1.1rem;color:var(--gold);margin-bottom:.4rem}
.stat span{color:var(--mute);font-size:.85rem}
.bar{height:14px;background:#0a0b12;border:2px solid var(--line);border-radius:3px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--mint);transition:width .5s}
.badges{display:flex;gap:.6rem;flex-wrap:wrap;margin:1rem 0 1.5rem}
.badge{padding:.35rem .8rem;border:2px dashed var(--line);color:var(--mute);border-radius:4px;font-size:.9rem}
.badge.on{border:2px solid var(--gold);color:var(--gold)}
.tag{font-size:.8rem;padding:.1rem .6rem;border-radius:3px;background:var(--mint);color:#052a1f;font-weight:700}
.msg{margin:.5rem 0;font-weight:600}.ok{color:var(--mint)}.bad{color:var(--red)}
.tabs{display:flex;gap:.5rem;margin-bottom:1rem}
.tabs button{flex:1}
table{width:100%;border-collapse:collapse}
th,td{padding:.7rem;text-align:start;border-bottom:2px solid var(--line)}
tr.me td{color:var(--gold);font-weight:700}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;padding:1rem}
.modal .card{max-width:420px;width:100%}
.row{display:flex;justify-content:space-between;gap:1rem;margin:.4rem 0}
.hide{display:none}
.complete{text-align:center;margin-top:1.25rem;padding:1.5rem;border:3px solid var(--gold);border-radius:6px;background:var(--bg)}
.complete .big{font-size:2.5rem}
.complete .cele{color:var(--gold);font-weight:700;font-size:1.25rem}
.complete.f1{background:linear-gradient(135deg,#050505,#111,#1f2937);border-color:#e10600;box-shadow:0 0 25px rgba(225,6,0,.35)}
.complete.football{background:linear-gradient(135deg,#052e16,#14532d);border-color:#facc15}
.complete.roblox{background:linear-gradient(135deg,#111827,#1e1b4b,#312e81);border-color:#8b5cf6;box-shadow:0 0 25px rgba(139,92,246,.4)}
.themes{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:0 0 .75rem}
.tcard{padding:0;overflow:hidden;cursor:pointer;text-align:center;color:var(--ink);font:inherit;background:var(--panel);border:3px solid var(--line);box-shadow:4px 4px 0 #000;border-radius:6px}
.tcard img{width:100%;height:110px;object-fit:cover;display:block}
.tcard b{display:block;padding:.6rem}
.tcard.sel{border-color:var(--gold);box-shadow:0 0 0 3px var(--gold),4px 4px 0 #000}
@media(max-width:700px){.themes{grid-template-columns:1fr}}
.chk{display:flex;gap:.6rem;align-items:flex-start;color:var(--ink)}.chk input{width:auto;margin:.4rem 0}
.hero{text-align:center;margin:2rem 0}
.hero h1{font-size:1.5rem;color:var(--gold)}
@media(max-width:700px){.stats{grid-template-columns:repeat(2,1fr)}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<nav id="nav"></nav>
<main id="app"></main>
<div id="modal"></div>

<script>
const T={
en:{courses:"Courses",board:"Leaderboard",out:"Log out",login:"Log in",register:"Create account",name:"Full name",email:"Email",pass:"Password (8+ characters)",role:"I am a",student:"Student",parent:"Parent",childEmail:"Your child's student email",
tag:"Learn to code. Level up. Get real tutor help.",xp:"XP",level:"Level",streak:"Streak",done:"Lessons done",next:"Next",submit:"Submit answer",answer:"Your answer",right:"Correct!",wrong:"Not quite. Check your code and try again.",
nextLesson:"Next lesson",back:"Back to courses",start:"Start learning",cont:"Continue",free:"First lesson is free",price:"BHD",unlock:"Unlock course",tutor:"Add one-to-one tutoring",pay:"Pay",cancel:"Cancel",total:"Total",paid:"Enrolled",tutored:"With tutor",
rank:"Rank",player:"Player",lessons:"Lessons",kids:"Your children",noKids:"No linked students yet.",enrolled:"Enrolled courses",recent:"Recent lessons",none:"Nothing yet",
b1:"Beginner",b2:"First code",b3:"On fire (3 in a row)",b4:"Course master",
e_invalid:"Check your details and try again.",e_bad_login:"Wrong email or password.",e_email_taken:"That email is already registered.",e_child_not_found:"No student found with that email.",e_locked:"Enroll to unlock this lesson.",
cDone:"Course complete!",cMsg:"You finished every lesson in",cThanks:"Keep coding and keep learning. Thank you for using CodeBridge!",themeT:"Choose your adventure",classic:"Classic theme",f1:"F1 Racing",football:"Football",roblox:"Roblox",sim:"Demo payment. No card is charged.",lessonOf:"Lesson",explain:"Explanation",question:"Challenge"},
ar:{courses:"الدورات",board:"لوحة المتصدرين",out:"تسجيل الخروج",login:"تسجيل الدخول",register:"إنشاء حساب",name:"الاسم الكامل",email:"البريد الإلكتروني",pass:"كلمة المرور (8 أحرف أو أكثر)",role:"أنا",student:"طالب",parent:"ولي أمر",childEmail:"البريد الإلكتروني لابنك الطالب",
tag:"تعلّم البرمجة. ارتقِ بمستواك. واحصل على دعم مدرّس حقيقي.",xp:"نقاط الخبرة",level:"المستوى",streak:"التتابع",done:"الدروس المكتملة",next:"التالي",submit:"إرسال الإجابة",answer:"إجابتك",right:"إجابة صحيحة!",wrong:"ليست صحيحة تمامًا. راجع الكود وحاول مرة أخرى.",
nextLesson:"الدرس التالي",back:"العودة إلى الدورات",start:"ابدأ التعلم",cont:"تابع",free:"الدرس الأول مجاني",price:"د.ب",unlock:"افتح الدورة",tutor:"أضف تدريسًا فرديًا",pay:"ادفع",cancel:"إلغاء",total:"المجموع",paid:"مشترك",tutored:"مع مدرّس",
rank:"الترتيب",player:"اللاعب",lessons:"الدروس",kids:"أبناؤك",noKids:"لا يوجد طلاب مرتبطون بعد.",enrolled:"الدورات المشترك بها",recent:"آخر الدروس",none:"لا شيء بعد",
b1:"مبتدئ",b2:"أول كود",b3:"مشتعل (3 متتالية)",b4:"خبير الدورة",
e_invalid:"تحقق من بياناتك وحاول مرة أخرى.",e_bad_login:"البريد الإلكتروني أو كلمة المرور غير صحيحة.",e_email_taken:"هذا البريد مسجل مسبقًا.",e_child_not_found:"لا يوجد طالب بهذا البريد.",e_locked:"اشترك لفتح هذا الدرس.",
cDone:"اكتملت الدورة!",cMsg:"لقد أنهيت جميع دروس",cThanks:"واصل البرمجة والتعلّم. شكرًا لاستخدامك CodeBridge!",themeT:"اختر مغامرتك",classic:"النمط الكلاسيكي",f1:"سباق فورمولا 1",football:"كرة القدم",roblox:"روبلوكس",sim:"دفع تجريبي. لن يتم خصم أي مبلغ.",lessonOf:"الدرس",explain:"الشرح",question:"التحدي"}};
const THEMES={
 f1:{img:"https://www.timeoutbahrain.com/cloud/timeoutbahrain/2024/09/17/409000265_18414303553033106_7265928152314773389_n.jpg",v:{"--bg":"#0b0b0d","--panel":"#17171c","--line":"#4a1d1d","--gold":"#ffcc00","--mint":"#ff4d4d","--btn-ink":"#1a1400"}},
 football:{img:"https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=600&q=80",v:{"--bg":"#0b1a10","--panel":"#12261a","--line":"#1f5a34","--gold":"#facc15","--mint":"#4ade80","--btn-ink":"#1a1400"}},
 roblox:{img:"https://images.unsplash.com/photo-1612287230202-1ff1d85d1bdf?auto=format&fit=crop&w=600&q=80",v:{"--bg":"#12102a","--panel":"#1c1840","--line":"#4c3a96","--gold":"#facc15","--mint":"#c084fc","--btn-ink":"#1a1400"}}};
const BASE={"--bg":"#10121c","--panel":"#191c2b","--line":"#2f3558","--gold":"#ffd23f","--mint":"#4de0b4","--btn-ink":"#1a1400"};
let theme=localStorage.getItem("cb_theme")||"";
function applyTheme(n){
  theme=THEMES[n]?n:"";localStorage.setItem("cb_theme",theme);
  const v=THEMES[theme]?.v||BASE;for(const k in v)document.documentElement.style.setProperty(k,v[k]);
}
function setTheme(n){applyTheme(n);if(me)api("theme",{theme:theme});render()}
applyTheme(theme);
const COURSES={html:"HTML",css:"CSS",js:"JavaScript",php:"PHP",java:"Java"};
let L=localStorage.getItem("cb_lang")||"en",me=null,cat=null,view="auth",mode="login",cur=null,step=0,fb=null;
const t=k=>T[L][k]||k, $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const lvl=x=>Math.floor(x/100)+1;
async function api(a,d){const r=await fetch("api.php?a="+a,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(d||{})});return r.json()}
const pick=o=>o[L==="ar"?1:0];

async function boot(){
  const r=await api("me");
  if(r.error){me=null;view="auth"}
  else{me=r;L=r.lang;if(r.theme!==undefined&&r.theme!==null)applyTheme(r.theme);await load();view=me.role==="student"?"home":"parent"}
  render();
}
async function load(){if(me.role==="student")cat=await api("catalog")}
function setLang(l){L=l;localStorage.setItem("cb_lang",l);if(me)api("lang",{lang:l});render()}

function render(){
  document.documentElement.lang=L;document.documentElement.dir=L==="ar"?"rtl":"ltr";
  $("#nav").innerHTML=`<span class="logo px" onclick="go(me?.role==='parent'?'parent':'home')">CODEBRIDGE</span>
   ${me?`${me.role==="student"?`<a href="#" onclick="go('home');return false">${t("courses")}</a>`:""}<a href="#" onclick="go('board');return false">${t("board")}</a>`:""}
   <button class="link" onclick="setLang('${L==="ar"?"en":"ar"}')">${L==="ar"?"English":"العربية"}</button>
   ${me?`<button class="link" onclick="logout()">${t("out")}</button>`:""}`;
  ({auth:rAuth,home:rHome,lesson:rLesson,board:rBoard,parent:rParent})[view]();
}
async function go(v){view=v;await load();render()}
async function logout(){await api("logout");me=null;cat=null;view="auth";render()}

/* ---------- Auth ---------- */
function rAuth(){
  const reg=mode==="register";
  $("#app").innerHTML=`<div class="hero"><h1 class="px">CODEBRIDGE</h1><p>${t("tag")}</p></div>
  <div class="card" style="max-width:440px;margin:auto">
   <div class="tabs"><button class="btn ${reg?"alt":""}" onclick="mode='login';render()">${t("login")}</button><button class="btn ${reg?"":"alt"}" onclick="mode='register';render()">${t("register")}</button></div>
   ${reg?`<label>${t("name")}</label><input id="f_name" autocomplete="name">
   <label>${t("role")}</label><select id="f_role" onchange="$('#f_child').parentElement.classList.toggle('hide',this.value!=='parent')"><option value="student">${t("student")}</option><option value="parent">${t("parent")}</option></select>
   <div class="hide"><label>${t("childEmail")}</label><input id="f_child" type="email"></div>`:""}
   <label>${t("email")}</label><input id="f_email" type="email" autocomplete="email">
   <label>${t("pass")}</label><input id="f_pass" type="password" autocomplete="${reg?"new-password":"current-password"}">
   <button class="btn" style="width:100%" onclick="auth()">${reg?t("register"):t("login")}</button>
   <p id="authMsg" class="msg bad" role="alert"></p></div>`;
}
async function auth(){
  const d={email:$("#f_email").value,password:$("#f_pass").value,lang:L};
  if(mode==="register"){d.name=$("#f_name").value;d.role=$("#f_role").value;d.child_email=$("#f_child").value}
  const r=await api(mode,d);
  if(r.error)return $("#authMsg").textContent=t("e_"+r.error);
  boot();
}

/* ---------- Student home ---------- */
const doneIn=c=>cat.lessons.filter(l=>l.course===c&&cat.done.includes(l.id)).length;
const inCourse=c=>cat.lessons.filter(l=>l.course===c);
const isEnrolled=c=>cat.enrolled.some(e=>e.course===c);
function rHome(){
  const x=me.xp,cd=cat.done.length;
  const master=Object.keys(COURSES).some(c=>inCourse(c).length&&doneIn(c)===inCourse(c).length);
  const bs=[[x>=10,"b1"],[cd>=1,"b2"],[me.streak>=3,"b3"],[master,"b4"]];
  $("#app").innerHTML=`<h2>${esc(me.name)}</h2>
  <h3>${t("themeT")}</h3><div class="themes">${Object.entries(THEMES).map(([k,o])=>`<button class="tcard ${theme===k?"sel":""}" onclick="setTheme('${k}')"><img src="${o.img}" alt="" loading="lazy"><b>${t(k)}</b></button>`).join("")}</div>
  <p><button class="btn alt" onclick="setTheme('')">${t("classic")}</button></p>
  <div class="stats">${[[x,"xp"],[lvl(x),"level"],[me.streak,"streak"],[cd,"done"]].map(([v,k])=>`<div class="card stat"><b>${v}</b><span>${t(k)}</span></div>`).join("")}</div>
  <div class="bar" role="progressbar" aria-valuenow="${x%100}" aria-valuemax="100"><i style="width:${x%100}%"></i></div>
  <div class="badges">${bs.map(([on,k])=>`<span class="badge ${on?"on":""}">${t(k)}</span>`).join("")}</div>
  <div class="grid">${Object.entries(COURSES).map(([c,n])=>{
    const tot=inCourse(c).length,d=doneIn(c),en=cat.enrolled.find(e=>e.course===c);
    return `<div class="card"><div class="row"><h3 class="px" style="font-size:.9rem">${n}</h3>${en?`<span class="tag">${t("paid")}${en.tutoring==1?" · "+t("tutored"):""}</span>`:""}</div>
    <div class="bar"><i style="width:${tot?d/tot*100:0}%"></i></div><p style="color:var(--mute)">${d}/${tot} ${t("lessons")}${en?"":" · "+t("free")}</p>
    <button class="btn" onclick="openCourse('${c}')">${d?t("cont"):t("start")}</button>
    ${en?"":`<button class="btn alt" onclick="checkout('${c}')">${t("unlock")} · ${cat.prices.course} ${t("price")}</button>`}</div>`}).join("")}</div>`;
}
function openCourse(c){
  const ls=inCourse(c),l=ls.find(l=>!cat.done.includes(l.id))||ls[0];
  openLesson(l.id);
}
function openLesson(id){
  const l=cat.lessons.find(l=>l.id===id),first=inCourse(l.course)[0].id;
  if(l.id!==first&&!isEnrolled(l.course))return checkout(l.course);
  cur=l;step=0;fb=null;view="lesson";render();
}

/* ---------- Lesson: explanation first, then question ---------- */
function rLesson(){
  const ls=inCourse(cur.course),i=ls.indexOf(cur)+1;
  let h=`<p style="color:var(--mute)">${COURSES[cur.course]} · ${t("lessonOf")} ${i}/${ls.length}</p><h2>${pick(cur.title)}</h2><div class="card">`;
  if(step===0){
    h+=`<h3>${t("explain")}</h3><p>${pick(cur.explain)}</p><pre>${esc(cur.example)}</pre><button class="btn" onclick="step=1;render()">${t("next")}</button>`;
  }else{
    h+=`<h3>${t("question")}</h3><p>${pick(cur.question)}</p><label for="code">${t("answer")}</label>
    <textarea id="code" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea>
    <button class="btn" onclick="submitCode()">${t("submit")}</button>
    <p id="fb" class="msg ${fb?(fb.ok?"ok":"bad"):""}" role="status">${fb?fb.text:""}</p>
    <div id="after"></div>`;
  }
  $("#app").innerHTML=h+`</div><p><button class="btn alt" onclick="go('home')">${t("back")}</button></p>`;
}
async function submitCode(){
  const r=await api("submit",{lesson_id:cur.id,code:$("#code").value});
  if(r.error==="locked")return checkout(cur.course);
  const f=$("#fb");
  if(r.correct){
    f.className="msg ok";f.textContent=t("right")+(r.gained?" +"+r.gained+" "+t("xp"):"");
    if(!cat.done.includes(cur.id))cat.done.push(cur.id);
    me.xp=r.xp;me.streak=r.streak;
    const ls=inCourse(cur.course),nx=ls[ls.indexOf(cur)+1];
    $("#after").innerHTML=nx?`<button class="btn" onclick="openLesson('${nx.id}')">${t("nextLesson")}</button>`:(doneIn(cur.course)===ls.length?complete():"");
  }else{f.className="msg bad";f.textContent=t("wrong");me.streak=0}
}

function complete(){
  const icon={f1:"🏎️🏁",football:"⚽🥅",roblox:"🎮🧱"}[theme]||"🎓🏆";
  return `<div class="complete ${theme}"><div class="big">${icon}</div><h3 class="px" style="font-size:1rem">${t("cDone")}</h3>
  <p>${t("cMsg")} ${COURSES[cur.course]}.</p><p><b>${esc(me.name)}</b> · ${t("xp")}: ${me.xp} · ${t("level")}: ${lvl(me.xp)}</p>
  <p class="cele">🎉🥳 🥳🎉</p><p>${t("cThanks")}</p></div>`;
}

/* ---------- Checkout (simulated) ---------- */
function checkout(c){
  const p=cat.prices;
  $("#modal").innerHTML=`<div class="modal" role="dialog" aria-modal="true"><div class="card">
  <h3>${COURSES[c]}</h3><div class="row"><span>${t("unlock")}</span><b>${p.course} ${t("price")}</b></div>
  <label class="chk"><input type="checkbox" id="tut" onchange="$('#tot').textContent=${p.course}+(this.checked?${p.tutoring}:0)+' ${t("price")}'"><span>${t("tutor")} (+${p.tutoring} ${t("price")})</span></label>
  <div class="row"><b>${t("total")}</b><b id="tot">${p.course} ${t("price")}</b></div>
  <p style="color:var(--mute);font-size:.85rem">${t("sim")}</p>
  <button class="btn" onclick="pay('${c}')">${t("pay")}</button> <button class="btn alt" onclick="$('#modal').innerHTML=''">${t("cancel")}</button></div></div>`;
}
async function pay(c){
  await api("enroll",{course:c,tutoring:$("#tut").checked});
  $("#modal").innerHTML="";await load();view="home";render();
}

/* ---------- Leaderboard ---------- */
async function rBoard(){
  const rows=await api("leaderboard"),medal=["🥇","🥈","🥉"];
  $("#app").innerHTML=`<h2>${t("board")}</h2><div class="card"><table><tr><th>${t("rank")}</th><th>${t("player")}</th><th>${t("level")}</th><th>${t("lessons")}</th><th>${t("xp")}</th></tr>
  ${rows.map((r,i)=>`<tr class="${r.name===me.name?"me":""}"><td>${medal[i]||i+1}</td><td>${esc(r.name)}</td><td>${lvl(+r.xp)}</td><td>${r.lessons}</td><td>${r.xp}</td></tr>`).join("")}</table></div>`;
}

/* ---------- Parent dashboard ---------- */
async function rParent(){
  const r=await api("children");
  $("#app").innerHTML=`<h2>${t("kids")}</h2>`+(r.children.length?r.children.map(k=>{
    const by={};k.done.forEach(d=>{const c=d.lesson_id.split("-")[0];by[c]=(by[c]||0)+1});
    return `<div class="card" style="margin-bottom:1.25rem"><h3>${esc(k.name)}</h3>
    <div class="stats">${[[k.xp,"xp"],[k.level,"level"],[k.streak,"streak"],[k.done.length,"done"]].map(([v,l])=>`<div class="stat"><b>${v}</b><span>${t(l)}</span></div>`).join("")}</div>
    ${Object.entries(COURSES).map(([c,n])=>{const d=by[c]||0,tot=r.totals[c]||0;return `<div class="row"><span>${n}</span><span>${d}/${tot}</span></div><div class="bar"><i style="width:${tot?d/tot*100:0}%"></i></div>`}).join("")}
    <h3 style="margin-top:1rem">${t("enrolled")}</h3><p>${k.enrollments.length?k.enrollments.map(e=>`${COURSES[e.course]}${e.tutoring==1?" ("+t("tutored")+")":""}`).join("، "):t("none")}</p></div>`}).join(""):`<p>${t("noKids")}</p>`);
}
boot();
</script>
</body>
</html>
